{
  "schemaVersion": 1,
  "id": "commerce-semantic-variants",
  "idNote": "id 是历史安装身份：技能名（wf-commerce-semantic-variants）、已安装目录与市场条目都按它对应，改名会破坏已安装用户的升级路径。标题与摘要已更新为「带货视频拆解与重制」，勿据此重命名 id。",
  "title": "带货视频拆解与重制",
  "titleEn": "Commerce video breakdown & remake",
  "summary": "拆解口播卖货视频，规划改拍提示词方案，再重制合成新成片",
  "category": "ad",
  "tags": [
    "视频拆解",
    "带货",
    "重制规划",
    "视频重制"
  ],
  "version": "1.4.0",
  "author": {
    "name": "AIArtEngine",
    "url": "https://github.com/Justin-sky/ai-art-engine"
  },
  "license": "CC-BY-4.0",
  "cover": "cover.png",
  "requires": {
    "nodeTypes": [
      "note.text",
      "semantic.analyze",
      "semantic.compile",
      "semantic.rebuild"
    ],
    "appMinVersion": "7.4.0"
  },
  "semanticPacks": [
    "semanticPacks/commerce-vocabulary.json",
    "semanticPacks/commerce-director-rules.json",
    "semanticPacks/commerce-director-persona.json"
  ],
  "plan": {
    "title": "带货视频拆解与重制",
    "nodes": [
      {
        "key": "analyze",
        "typeId": "semantic.analyze",
        "title": "视频拆解",
        "params": {
          "vocabulary": "commerce.v1"
        }
      },
      {
        "key": "compile",
        "typeId": "semantic.compile",
        "title": "重制规划",
        "params": {
          "semanticLlm": true
        }
      },
      {
        "key": "rebuild",
        "typeId": "semantic.rebuild",
        "title": "视频重制",
        "params": {
          "rebuildMode": "shots",
          "rebuildMaxShots": 12
        }
      },
      {
        "key": "note",
        "typeId": "note.text",
        "title": "使用说明",
        "params": {
          "text": "流程（逆向视频工程）：把口播/卖货视频接到「视频拆解」→ 双击查看时间线，在下方「修改」面板里按镜头改主体动作 / 镜头语言 / 画面风格、改台词、换实体参考或删镜（改动直接存进时间线）→「重制规划」比对拆解基线，得出要重新生成的镜头与要重新配音的台词，并拼出每镜提示词方案（双击打开指令面板选文本模型、规则包、写规划要求）→「视频重制」双击打开指令面板选视频模型：未改的镜头直通原片段，改过的镜头重新生成，改过的台词重新配音，本地拼接出成片（只输出视频；成片与清单在右侧面板预览）。零修改即还原原片。随包 semanticPacks/ 含带货词表、导演规则与人格。"
        }
      }
    ],
    "edges": [
      {
        "from": "analyze",
        "to": "compile",
        "fromPort": "out",
        "toPort": "in"
      },
      {
        "from": "compile",
        "to": "rebuild",
        "fromPort": "out",
        "toPort": "in"
      }
    ]
  }
}
