{
  "schemaVersion": 1,
  "id": "short-drama",
  "title": "影视全流程",
  "titleEn": "Film pipeline",
  "summary": "剧本→分镜拆解→导演审核自动修订→角色场景设定→批量拍摄（质检重拍+图生视频）",
  "category": "film",
  "tags": [],
  "version": "1.1.0",
  "author": {
    "name": "AIArtEngine",
    "url": "https://github.com/Justin-sky/ai-art-engine"
  },
  "license": "CC-BY-4.0",
  "cover": "cover.png",
  "requires": {
    "nodeTypes": [
      "film.workbench",
      "note.text",
      "play.script"
    ],
    "appMinVersion": "7.5.0"
  },
  "plan": {
    "title": "影视全流程（Agent 闭环）",
    "nodes": [
      {
        "key": "script",
        "typeId": "play.script",
        "title": "剧本",
        "params": {
          "text": "（在此填写剧本 / 故事梗概；也可以先用「剧本生成」节点产出后接入分镜拆解）"
        }
      },
      {
        "key": "workbench",
        "typeId": "film.workbench",
        "title": "影视工作台",
        "params": {
          "filmAspectRatio": "9:16",
          "filmTargetShots": 0,
          "filmReviewMaxRounds": 2,
          "filmCastKinds": "character,location",
          "filmRenderMode": "video",
          "filmRenderQc": true,
          "filmRenderMaxRetries": 1
        }
      },
      {
        "key": "note",
        "typeId": "note.text",
        "title": "流水线说明",
        "params": {
          "text": "流程：剧本 → 影视工作台（双击进入工作台，顶部切换 ①分镜拆解 / ②导演审核 / ③角色场景设定 / ④批量拍摄，既可分阶段单独运行，也可一键全流程运行）。\n\n迭代：在同一工作台里改任一镜头、锁镜或单卡重跑，所有阶段实时共享同一份分镜与设定数据。\n\n精修：需要单独打磨某一镜时，从影视工作台接一个「镜头」节点，再接图片 / 视频生成节点手动调参。"
        }
      }
    ],
    "edges": [
      {
        "from": "script",
        "to": "workbench",
        "fromPort": "out",
        "toPort": "in"
      }
    ]
  }
}
