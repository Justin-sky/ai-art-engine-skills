  },
  "license": "CC-BY-4.0",
  "cover": "cover.png",
  "requires": {
    "nodeTypes": [
      "asset.image",
      "asset.music",
      "asset.video",
      "asset.voice",
      "note.text",
      "output.timeline",
      "text.plain"
    ],
    "appMinVersion": "7.1.0"
  },
  "plan": {
    "title": "分镜出片",
    "nodes": [
      {
        "key": "shots",
        "typeId": "text.plain",
        "title": "导演分镜与旁白脚本",
        "params": {
          "text": "【镜头1·远景定场】雨夜霓虹街道，侦探撑伞驻足在全息广告牌下，冷暖光影交错。旁白：「这座城市从不缺少秘密，只缺少掀开帷幕的人。」\n【镜头2·中景跟拍】侦探压低帽檐推开赛博酒馆大门，回头看向身后暗巷。旁白：「当第十二声钟响落下，所有的线索都指向了同一个名字。」\n【镜头3·特写高潮】瞳孔中倒映出加密芯片的蓝光，神情笃定。旁白：「而这一次，真相无处可逃。」"
        }
      },
      {
        "key": "charRef",
        "typeId": "asset.image",
        "title": "主角与光影定妆锚点",
        "params": {
          "generateInstruction": "电影级主角定妆与美术色调基准图：主角半身至全身设定，服饰质感细腻、面部特征鲜明，明确主光源色温与轮廓光风格，纯画面无文字，作为全部镜头的一致性参考锚点",
          "generateAspectRatio": "16:9"
        }
      },
      {
        "key": "board1",
        "typeId": "asset.image",
        "title": "分镜 1 · 远景定场",
        "params": {
          "generateInstruction": "镜头 1（远景定场镜头 Establishing Shot）：展现宏大环境空间与主角所处位置，景深层次丰富，严格保持与定妆锚点一致的主角造型与光影色调，纯画面无文字",
          "generateAspectRatio": "16:9"
        }
      },
      {
        "key": "board2",
        "typeId": "asset.image",
        "title": "分镜 2 · 中景叙事推进",
        "params": {
          "generateInstruction": "镜头 2（中景人物动作镜头 Medium Shot）：主角核心动作与场景交互，承接镜头 1 环境光效，严格保持主角面容与服装一致，纯画面无文字",
          "generateAspectRatio": "16:9"
        }
      },
      {
        "key": "board3",
        "typeId": "asset.image",
        "title": "分镜 3 · 特写情绪高潮",
        "params": {
          "generateInstruction": "镜头 3（面部情绪特写镜头 Close-up）：浅景深聚焦主角眼神与细微神态转折，戏剧光影强烈，严格保持主角面部特征一致，纯画面无文字",
          "generateAspectRatio": "16:9"
        }
      },
      {
        "key": "clip1",
        "typeId": "asset.video",
        "title": "镜头 1 · 定场运镜视频",
        "params": {
          "generateInstruction": "摄影机缓慢平稳向前推进（Dolly In），环境光影与氛围自然流动，主角微动定场，电影级宽画幅质感",
          "generateDuration": 5,
          "generateAspectRatio": "16:9"
        }
      },
      {
        "key": "clip2",
        "typeId": "asset.video",
        "title": "镜头 2 · 中景跟拍视频",
        "params": {
          "generateInstruction": "摄影机侧面平滑跟拍（Tracking Shot），主角动作连贯自然，衣摆与场景光影真实互动",
          "generateDuration": 5,
          "generateAspectRatio": "16:9"
        }
      },
      {
        "key": "clip3",
        "typeId": "asset.video",
        "title": "镜头 3 · 高潮特写视频",
        "params": {
          "generateInstruction": "微距浅景深推镜，主角眼神凝聚、光影在瞳孔与面部轮廓间微妙流转，情绪张力拉满",
          "generateDuration": 5,
          "generateAspectRatio": "16:9"
        }
      },
      {
        "key": "voice1",
        "typeId": "asset.voice",
        "title": "镜头 1 旁白配音",
        "params": {
          "generateInstruction": "这座城市从不缺少秘密，只缺少掀开帷幕的人。"
        }
      },
      {
        "key": "voice2",
        "typeId": "asset.voice",
        "title": "镜头 2 旁白配音",
        "params": {
          "generateInstruction": "当第十二声钟响落下，所有的线索都指向了同一个名字。"
        }
      },
      {
        "key": "voice3",
        "typeId": "asset.voice",
        "title": "镜头 3 高潮旁白",
        "params": {
          "generateInstruction": "而这一次，真相无处可逃。"
        }
      },
      {
        "key": "bgm",
        "typeId": "asset.music",
        "title": "电影氛围配乐",
        "params": {
          "generateInstruction": "电影感大提琴与环境合成器铺底配乐，从低徊悬念逐步推向情绪高潮",
          "generateMusicInstrumental": true
        }
      },
      {
        "key": "timeline",
        "typeId": "output.timeline",
        "title": "分镜成片时间线"
      },
      {
        "key": "note",
        "typeId": "note.text",
        "title": "导演分镜全流程说明",
        "params": {
          "text": "专业分镜出片全流程：\n1. 角色与色调锚定：「主角与光影定妆锚点」通过 in-image 端口锁死全部 3 个分镜关键帧（远景定场 → 中景推进 → 特写高潮），保证全片人物与美术风格统一。\n2. 逐镜图生视频 + 逐镜配音：每个分镜独立转动态视频并配齐对应旁白，外加电影氛围 BGM。\n3. 时间线自动合成：所有镜头视频、旁白与 BGM 已接入「分镜成片时间线」，运行即自动对齐声画、烧录字幕并导出完整短片。"
        }
      }
    ],
