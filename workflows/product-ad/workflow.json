{
  "schemaVersion": 1,
  "id": "product-ad",
  "title": "产品广告",
  "titleEn": "Product ad",
  "summary": "产品Brief→高定棚拍主视觉锚点→痛点引入/微距卖点/生活场景三镜TVC视频+广告配音+BGM→成片时间线",
  "category": "ad",
  "tags": [
    "商业TVC",
    "产品广告",
    "棚拍主视觉",
    "三镜带货",
    "成片时间线"
  ],
  "version": "2.0.0",
  "author": {
    "name": "AIArtEngine",
    "url": "https://github.com/Justin-sky/ai-art-engine"
  },
  "license": "CC-BY-4.0",
  "cover": "cover.png",
  "requires": {
    "nodeTypes": [
      "asset.image",
      "asset.music",
      "asset.video",
      "asset.voice",
      "note.text",
      "output.timeline",
      "play.script"
    ],
    "appMinVersion": "7.1.0"
  },
  "plan": {
    "title": "产品广告",
    "nodes": [
      {
        "key": "copy",
        "typeId": "play.script",
        "title": "品牌卖点与脚本",
        "params": {
          "text": "（填写产品名称、核心材质/科技卖点、目标人群使用场景与品牌口播金句）"
        }
      },
      {
        "key": "hero",
        "typeId": "asset.image",
        "title": "产品棚拍主视觉（锚点）",
        "params": {
          "generateInstruction": "商业级产品英雄棚拍主视觉（Hero Shot）：经典三点柔光箱布光，轮廓高光锐利，材质肌理与工业设计细节清晰，高级纯净背景，无杂乱文字，作为全片产品外观锁定的唯一锚点",
          "generateAspectRatio": "16:9"
        }
      },
      {
        "key": "scene",
        "typeId": "asset.image",
        "title": "真实生活使用场景",
        "params": {
          "generateInstruction": "产品在理想生活场景中的真实使用画面：自然晨光或温暖室内光影，严格保持与棚拍主视觉完全一致的产品外观、比例与配色，营造极强代入感与种草氛围，纯画面无文字",
          "generateAspectRatio": "16:9"
        }
      },
      {
        "key": "detail",
        "typeId": "asset.image",
        "title": "微距工艺卖点特写",
        "params": {
          "generateInstruction": "商业微距镜头特写（Macro Shot）：聚焦产品核心材质纹理、精密结构或水珠/光影质感，浅景深突出高端做工，严格保持与主视觉一致的外观细节，纯画面无文字",
          "generateAspectRatio": "16:9"
        }
      },
      {
        "key": "videoHero",
        "typeId": "asset.video",
        "title": "产品流光亮相视频",
        "params": {
          "generateInstruction": "商业广告级缓慢环绕推镜（Orbit & Push In），轮廓柔光沿产品表面平滑流淌，尽显高端工业质感",
          "generateDuration": 5,
          "generateAspectRatio": "16:9"
        }
      },
      {
        "key": "videoScene",
        "typeId": "asset.video",
        "title": "场景使用体验视频",
        "params": {
          "generateInstruction": "真实使用场景中的自然动态运镜，光影柔和温暖，展现产品带来的愉悦生活体验，产品外观稳定不变形",
          "generateDuration": 5,
          "generateAspectRatio": "16:9"
        }
      },
      {
        "key": "voice",
        "typeId": "asset.voice",
        "title": "品牌质感旁白配音",
        "params": {
          "generateInstruction": "极具质感与亲和力的商业广告旁白音色，语调从容自信，清晰传达产品核心科技卖点与品牌主张"
        }
      },
      {
        "key": "bgm",
        "typeId": "asset.music",
        "title": "商业品牌氛围配乐",
        "params": {
          "generateInstruction": "现代极简高级感商业广告背景音乐，清脆钢琴与轻电子节拍交织，格调优雅摩登",
          "generateMusicInstrumental": true
        }
      },
      {
        "key": "timeline",
        "typeId": "output.timeline",
        "title": "广告成片时间线"
      },
      {
        "key": "note",
        "typeId": "note.text",
        "title": "商业广告制作说明",
        "params": {
          "text": "商业产品广告全流程：\n1. 产品外观锁死：「产品棚拍主视觉（锚点）」通过 in-image 端口同时锁定「真实生活使用场景」与「微距工艺卖点特写」，确保不同镜头里产品不走样。\n2. 亮相 + 场景 + 特写多维呈现：棚拍流光视频、场景体验视频与微距特写图共同汇入「广告成片时间线」，搭配品牌口播与定制 BGM 一键合成商业级 TVC 短片。"
        }
      }
    ],
    "edges": [
