{
  "schemaVersion": 1,
  "id": "anim2d-gif",
  "title": "2D 帧动画",
  "titleEn": "2D frame anim",
  "summary": "序列图 / 动作视频 → 自动抠底稳像 → 逐帧 PNG + GIF 动图",
  "category": "game",
  "tags": [
    "2D",
    "帧动画",
    "GIF",
    "序列图",
    "视频抽帧"
  ],
  "version": "1.1.0",
  "author": {
    "name": "AIArtEngine",
    "url": "https://github.com/Justin-sky/ai-art-engine"
  },
  "license": "CC-BY-4.0",
  "cover": "cover.png",
  "requires": {
    "nodeTypes": [
      "anim.2d",
      "asset.image",
      "note.text"
    ],
    "appMinVersion": "7.1.0"
  },
  "plan": {
    "title": "2D 帧动画（GIF）",
    "nodes": [
      {
        "key": "sheet",
        "typeId": "asset.image",
        "title": "动作序列图",
        "params": {
          "generateInstruction": "为同一角色生成「行走」动作的序列图（sprite sheet）：一张图内按 1 行 4 列分格，帧序从左到右，格子无缝拼接、无边框与分隔线，纯色干净背景，各格角色的外观、体型、配色与画风完全一致，仅姿态不同"
        }
      },
      {
        "key": "anim",
        "typeId": "anim.2d",
        "title": "2D帧动画",
        "params": {
          "animRows": 1,
          "animCols": 4,
          "animPresetId": "walk",
          "animInstruction": "角色侧面行走循环：完整步态周期，四肢摆动自然，各帧外形一致",
          "animKeyColor": "auto",
          "animStabilize": "ground",
          "animGifFps": 12
        }
      },
      {
        "key": "note",
        "typeId": "note.text",
        "title": "出图说明",
        "params": {
          "text": "运行后「2D帧动画」节点按行列切出逐帧 PNG（out 帧 / out-all 全部帧），自动抠底并按脚底原地稳像（animKeyColor=auto, animStabilize=ground），再经 out-gif 端口产出 GIF 动图（animGifFps=12）；也可直接把动作视频连到 in-video 端口抽帧转序列图，或双击节点进入全屏帧动画工作台。"
        }
      }
    ],
    "edges": [
      {
        "from": "sheet",
        "to": "anim"
      }
    ]
  }
}
